#include "defines.h"

/*
    Function: cbr_fnc_slew
    Доворот сектора оператором.

    Напрямок пише САМ оператор, одразу публічно. Раніше число йшло на
    сервер, а в себе клалось наперед, щоб індикатор не смикався на
    пінгу, — і на швидкому доворі сектор стрибав туди-сюди: серверне
    відлуння приходило вже застарілим і перетирало те, що клієнт устиг
    накрутити далі.

    Сервером тут володіти нема чого: напрямок читає лише машина
    оператора — індикатор, перевірка сектора при захопленні й при
    засічці. Решті екіпажу він потрібен тільки щоб бачити те саме.
*/

params ["_veh", "_delta"];

_veh setVariable [
    "cbr_bearing",
    ((_veh getVariable ["cbr_bearing", getDir _veh]) + _delta + 360) mod 360,
    true
];
